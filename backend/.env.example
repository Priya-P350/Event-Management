# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5100

# Drizzle ORM Database Connection (Supabase PostgreSQL / Direct Postgres Connection)
# Leave blank to automatically use local embedded SQLite database
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Authentication (JWT Secret & Expiration)
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Payment Gateway (Razorpay Credentials)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Email Server (Resend API or SMTP Credentials)
# Set RESEND_API_KEY to use Resend API, or fill SMTP fields for Nodemailer
RESEND_API_KEY=re_123456789_your_resend_api_key
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM="EventHub Tickets" <tickets@eventhub.com>
